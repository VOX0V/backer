# Compte admin créé automatiquement au tout premier démarrage
# (seulement si la table des utilisateurs est vide). Change le mot de passe
# ensuite depuis /admin puis retire ces lignes si tu veux.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_moi

# "https" si Backer est accédé uniquement via un tunnel/reverse-proxy en TLS
# (recommandé). Sinon "http" -- le cookie de session ne sera alors pas
# marqué Secure, à réserver à un accès purement local.
CONNECTION_TYPE=https

DATA_DIR=/app/data

# --- Jobs de sauvegarde ---
# Un bloc BACKN_* par job (N = 1, 2, 3, ...). NAME/SOURCE/DEST obligatoires.
# CRON est optionnel : utilisé seulement à la création du job (valeur par
# défaut si absent : "0 3 * * *" = tous les jours à 3h). Une fois le job
# créé, la planification se change depuis le dashboard web -- modifier
# BACKN_CRON ensuite dans le .env n'aura plus d'effet sur un job existant.
#
# SOURCE doit être un chemin sous un des volumes montés en lecture (voir
# docker-compose.yml) : /home/srv, /mnt/netsec, /mnt/piserv.
# DEST doit être un chemin sous /mnt/hdd (seule racine montée en écriture).

BACK1_NAME=DebServ
BACK1_SOURCE=/home/srv
BACK1_DEST=/mnt/hdd/onedrive/backups/debserv
BACK1_CRON=0 3 * * *

BACK2_NAME=NetSec
BACK2_SOURCE=/mnt/netsec
BACK2_DEST=/mnt/hdd/onedrive/backups/netsec
BACK2_CRON=0 4 * * *

BACK3_NAME=PiServ
BACK3_SOURCE=/mnt/piserv
BACK3_DEST=/mnt/hdd/onedrive/backups/piserv
BACK3_CRON=0 5 * * *
