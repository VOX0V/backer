# Compte admin créé automatiquement au tout premier démarrage
# (seulement si la table des utilisateurs est vide). Change le mot de passe
# ensuite depuis /admin puis retire ces lignes si tu veux.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_moi

# "https" si Backer est accédé uniquement via un tunnel/reverse-proxy en TLS
# (recommandé). Sinon "http" -- le cookie de session ne sera alors pas
# marqué Secure, à réserver à un accès purement local.
CONNECTION_TYPE=https

DATA_DIR=/app/data

# --- Jobs de sauvegarde ---
# Les sauvegardes ne sont plus définies ici : elles sont dans le fichier
# jobs.yml du dossier de données (par défaut /app/data/jobs.yml), modifiable
# depuis l'éditeur web (/admin/jobs) ou directement dans le fichier.
# Voir jobs.yml.example pour le format.
#
# Optionnel : autre emplacement du fichier.
# JOBS_FILE=/app/data/jobs.yml

# --- Log du client OneDrive (confirmation des uploads) ---
# Optionnel : chemin du log, monté en lecture seule dans le conteneur.
# ONEDRIVE_LOG_FILE=/onedrive-log/onedrive.onedrive.log

# --- Alertes e-mail (optionnel) ---
# Backer envoie un e-mail pour : sauvegarde en échec, upload non confirmé,
# archive beaucoup plus petite que la précédente, disque presque plein.
# Avec Gmail : activer la validation en deux étapes sur le compte, puis créer
# un « mot de passe d'application » (le mot de passe normal ne fonctionne pas).
# Les seuils se règlent dans le bloc `alerts:` de jobs.yml.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ton.adresse@gmail.com
# SMTP_PASSWORD=mot-de-passe-d-application
# ALERT_TO=ton.adresse@gmail.com
# ALERT_FROM=ton.adresse@gmail.com
